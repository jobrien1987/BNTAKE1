# ---------------------------------------------------------------------------
# BOOSIE NETWORK — environment template
# Copy to `.env` and fill in. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Public origin of the deployed application (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# 32+ char random string. Generate: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/boosie_network?schema=public"
# Optional direct (non-pooled) connection for migrations on hosted Postgres.
# DIRECT_DATABASE_URL="postgresql://..."

# --- Stripe -----------------------------------------------------------------
# Leave blank to run the app with checkout disabled (UI shows a configured
# "payments unavailable" state instead of a broken button).
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CURRENCY="usd"

# --- Object storage (S3 / Cloudflare R2 / any S3-compatible) ----------------
# Leave S3_BUCKET blank in development to use the local disk fallback
# (files land in ./public/uploads and are served from /uploads/...).
S3_ENDPOINT=""                 # e.g. https://<accountid>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
# Public base URL that serves objects in the bucket (CDN or bucket URL).
S3_PUBLIC_BASE_URL=""

# Comma-separated hostnames allowed by next/image for remote media.
NEXT_PUBLIC_MEDIA_HOSTS=""

# --- Email (transactional) --------------------------------------------------
# EMAIL_PROVIDER: console | resend | smtp-disabled
EMAIL_PROVIDER="console"
EMAIL_FROM="Boosie Network <no-reply@boosienetwork.com>"
RESEND_API_KEY=""

# --- Live streaming provider ------------------------------------------------
# LIVE_PROVIDER: none | external
# "external" simply plays back an admin-configured HLS/embed URL per stream.
LIVE_PROVIDER="none"
FEATURE_LIVE_ENABLED="true"

# --- Radio ------------------------------------------------------------------
# Optional default stream URL for Badazz Radio (also configurable in Admin).
RADIO_DEFAULT_STREAM_URL=""

# --- Seeding (development only) --------------------------------------------
SEED_OWNER_EMAIL="owner@boosienetwork.local"
# If omitted, the seed script generates a random password and prints it once.
SEED_OWNER_PASSWORD=""
SEED_OWNER_NAME="Network Owner"
