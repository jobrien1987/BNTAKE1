// Boosie Network — relational schema
// All money is stored as integer cents (never floats).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  USER
  ARTIST
  ARTIST_PRO
  EDITOR
  MODERATOR
  ADMIN
  OWNER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum AccessType {
  FREE
  MEMBERSHIP
  PURCHASE
}

enum VideoKind {
  MOVIE
  DOCUMENTARY
  SERIES
  EPISODE
  INTERVIEW
  MUSIC_VIDEO
  TRAILER
  BEHIND_THE_SCENES
  EXCLUSIVE
}

enum PlanKind {
  FAN
  CREATOR
}

enum PlanKey {
  FREE
  FAMILY
  INSIDER
  ARTIST
  ARTIST_PRO
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  FULFILLED
  CANCELED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PurchasableKind {
  PRODUCT
  SONG
  ALBUM
  VIDEO
  DIGITAL_PRODUCT
  MEMBERSHIP
  DONATION
}

enum EntitlementKind {
  SONG
  ALBUM
  VIDEO
  DIGITAL_PRODUCT
  MEMBERSHIP
}

enum EntitlementSource {
  PURCHASE
  SUBSCRIPTION
  GRANT
}

enum MediaKind {
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
}

enum LiveStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELED
}

enum CreatorTier {
  ARTIST
  ARTIST_PRO
}

enum CreatorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  VIOLENCE
  SEXUAL_CONTENT
  MISINFORMATION
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

enum ReportTargetType {
  POST
  COMMENT
  USER
}

enum NotificationType {
  FOLLOW
  COMMENT
  REPLY
  REACTION
  ORDER
  SUBSCRIPTION
  CONTENT
  SYSTEM
  MODERATION
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum HomepageSectionType {
  HERO
  CULTURE_RAIL
  WATCH_RAIL
  LISTEN_RAIL
  RADIO
  SHOP_RAIL
  ARTIST_SPOTLIGHT
  COMMUNITY
  HEARTFELT
  MEMBERSHIP
  BOOSIE_FEATURE
}

enum HomepageItemKind {
  ARTICLE
  VIDEO
  SONG
  ALBUM
  ARTIST
  PRODUCT
  CAMPAIGN
  LIVE_STREAM
  CUSTOM
}

// ---------------------------------------------------------------------------
// IDENTITY / AUTH
// ---------------------------------------------------------------------------

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  emailVerified  DateTime?
  passwordHash   String
  name           String
  username       String     @unique
  bio            String?
  avatarUrl      String?
  bannerUrl      String?
  location       String?
  role           Role       @default(USER)
  status         UserStatus @default(ACTIVE)
  isCreator      Boolean    @default(false)
  lastLoginAt    DateTime?
  failedLogins   Int        @default(0)
  lockedUntil    DateTime?
  stripeCustomerId String?  @unique
  marketingOptIn Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  sessions          Session[]
  resetTokens       PasswordResetToken[]
  carts             Cart[]
  orders            Order[]
  entitlements      Entitlement[]
  subscriptions     Subscription[]
  creatorProfile    CreatorProfile?
  articlesAuthored  Article[]           @relation("ArticleEditor")
  posts             Post[]
  comments          Comment[]
  reactions         Reaction[]
  following         Follow[]            @relation("Follower")
  followers         Follow[]            @relation("Following")
  artistFollows     ArtistFollow[]
  notifications     Notification[]
  reportsFiled      Report[]            @relation("Reporter")
  blocksMade        Block[]             @relation("Blocker")
  blocksReceived    Block[]             @relation("Blocked")
  auditLogs         AuditLog[]
  events            AnalyticsEvent[]
  mediaUploads      MediaAsset[]
  agreementAccepts  CreatorAgreementAcceptance[]
  moderationActions ModerationAction[]  @relation("Moderator")
  donations         Donation[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ---------------------------------------------------------------------------
// MEDIA
// ---------------------------------------------------------------------------

model MediaAsset {
  id           String    @id @default(cuid())
  kind         MediaKind
  storageKey   String    @unique
  url          String
  fileName     String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  durationSec  Int?
  altText      String?
  uploadedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([kind])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// CULTURE (editorial)
// ---------------------------------------------------------------------------

model Author {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  title       String?
  bio         String?
  avatarUrl   String?
  twitterUrl  String?
  instagramUrl String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  articles Article[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  articles Article[]
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  articles Article[] @relation("ArticleTags")
}

model Article {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  dek            String?
  excerpt        String?
  body           String        @db.Text
  heroImageUrl   String?
  thumbnailUrl   String?
  socialImageUrl String?
  seoTitle       String?
  seoDescription String?
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  featured       Boolean       @default(false)
  breaking       Boolean       @default(false)
  readMinutes    Int           @default(3)
  viewCount      Int           @default(0)
  authorId       String?
  categoryId     String?
  editorId       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  author   Author?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  editor   User?     @relation("ArticleEditor", fields: [editorId], references: [id], onDelete: SetNull)
  tags     Tag[]     @relation("ArticleTags")

  relatedSongs    Song[]    @relation("ArticleSongs")
  relatedProducts Product[] @relation("ArticleProducts")
  relatedArtists  Artist[]  @relation("ArticleArtists")

  homepageItems HomepageItem[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([featured])
  @@index([breaking])
}

// ---------------------------------------------------------------------------
// MUSIC (Listen)
// ---------------------------------------------------------------------------

model Genre {
  id     String  @id @default(cuid())
  name   String  @unique
  slug   String  @unique

  songs  Song[]  @relation("SongGenres")
  albums Album[] @relation("AlbumGenres")
  videos Video[] @relation("VideoGenres")
}

model Artist {
  id           String        @id @default(cuid())
  stageName    String
  slug         String        @unique
  bio          String?       @db.Text
  location     String?
  profileImageUrl String?
  heroImageUrl String?
  websiteUrl   String?
  instagramUrl String?
  twitterUrl   String?
  youtubeUrl   String?
  spotifyUrl   String?
  status       ContentStatus @default(DRAFT)
  featured     Boolean       @default(false)
  verified     Boolean       @default(false)
  followerCount Int          @default(0)
  ownerId      String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  owner  CreatorProfile? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  songs  Song[]
  albums Album[]
  featuredOn Song[]  @relation("SongFeaturedArtists")
  videos Video[]     @relation("VideoArtists")
  products Product[] @relation("ProductArtists")
  articles Article[] @relation("ArticleArtists")
  follows ArtistFollow[]
  liveStreams LiveStream[]
  homepageItems HomepageItem[]

  @@index([status])
  @@index([featured])
}

model Album {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  artistId     String
  description  String?       @db.Text
  artworkUrl   String?
  releaseDate  DateTime?
  priceCents   Int?
  purchasable  Boolean       @default(false)
  accessType   AccessType    @default(FREE)
  featured     Boolean       @default(false)
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  artist Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  songs  Song[]
  genres Genre[] @relation("AlbumGenres")
  soundtrackFor Video[] @relation("VideoSoundtrack")
  homepageItems HomepageItem[]

  @@index([artistId])
  @@index([status])
  @@index([featured])
}

model Song {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  artistId     String
  albumId      String?
  trackNumber  Int?
  artworkUrl   String?
  audioUrl     String?
  previewUrl   String?
  durationSec  Int           @default(0)
  explicit     Boolean       @default(false)
  releaseDate  DateTime?
  priceCents   Int?
  purchasable  Boolean       @default(false)
  accessType   AccessType    @default(FREE)
  featured     Boolean       @default(false)
  status       ContentStatus @default(DRAFT)
  playCount    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  artist          Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  album           Album?   @relation(fields: [albumId], references: [id], onDelete: SetNull)
  featuredArtists Artist[] @relation("SongFeaturedArtists")
  genres          Genre[]  @relation("SongGenres")
  articles        Article[] @relation("ArticleSongs")
  playlistItems   PlaylistItem[]
  radioPlays      RadioPlay[]
  homepageItems   HomepageItem[]

  @@index([artistId])
  @@index([albumId])
  @@index([status])
  @@index([featured])
}

model Playlist {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?
  artworkUrl  String?
  status      ContentStatus @default(DRAFT)
  featured    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  items PlaylistItem[]
}

model PlaylistItem {
  id         String @id @default(cuid())
  playlistId String
  songId     String
  position   Int    @default(0)

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([playlistId, songId])
  @@index([playlistId, position])
}

// ---------------------------------------------------------------------------
// RADIO
// ---------------------------------------------------------------------------

model RadioStation {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  tagline     String?
  description String?  @db.Text
  logoUrl     String?
  heroImageUrl String?
  streamUrl   String?
  isLive      Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shows RadioShow[]
  plays RadioPlay[]
  slots RadioSlot[]
}

model RadioShow {
  id          String   @id @default(cuid())
  stationId   String
  title       String
  slug        String   @unique
  host        String?
  description String?  @db.Text
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  station RadioStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  slots   RadioSlot[]

  @@index([stationId])
}

model RadioSlot {
  id        String   @id @default(cuid())
  stationId String
  showId    String?
  dayOfWeek Int
  startMin  Int
  endMin    Int
  createdAt DateTime @default(now())

  station RadioStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  show    RadioShow?   @relation(fields: [showId], references: [id], onDelete: SetNull)

  @@index([stationId, dayOfWeek, startMin])
}

model RadioPlay {
  id         String   @id @default(cuid())
  stationId  String
  songId     String?
  trackTitle String
  artistName String
  artworkUrl String?
  playedAt   DateTime @default(now())

  station RadioStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  song    Song?        @relation(fields: [songId], references: [id], onDelete: SetNull)

  @@index([stationId, playedAt])
}

// ---------------------------------------------------------------------------
// WATCH
// ---------------------------------------------------------------------------

model Video {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  kind           VideoKind     @default(MOVIE)
  synopsis       String?       @db.Text
  posterUrl      String?
  backdropUrl    String?
  trailerUrl     String?
  mediaProvider  String?
  mediaUrl       String?
  durationSec    Int           @default(0)
  releaseDate    DateTime?
  director       String?
  contentRating  String?
  accessType     AccessType    @default(FREE)
  priceCents     Int?
  purchasable    Boolean       @default(false)
  featured       Boolean       @default(false)
  status         ContentStatus @default(DRAFT)
  viewCount      Int           @default(0)
  seriesId       String?
  seasonNumber   Int?
  episodeNumber  Int?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  series   Video?  @relation("SeriesEpisodes", fields: [seriesId], references: [id], onDelete: SetNull)
  episodes Video[] @relation("SeriesEpisodes")
  cast     CastMember[]
  genres   Genre[] @relation("VideoGenres")
  artists  Artist[] @relation("VideoArtists")
  soundtrackAlbumId String?
  soundtrackAlbum   Album?  @relation("VideoSoundtrack", fields: [soundtrackAlbumId], references: [id], onDelete: SetNull)
  homepageItems HomepageItem[]
  replayOf LiveStream[]

  @@index([kind, status])
  @@index([featured])
  @@index([seriesId])
}

model CastMember {
  id      String  @id @default(cuid())
  videoId String
  name    String
  role    String?
  imageUrl String?
  position Int    @default(0)

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, position])
}

// ---------------------------------------------------------------------------
// LIVE
// ---------------------------------------------------------------------------

model LiveStream {
  id           String     @id @default(cuid())
  title        String
  slug         String     @unique
  description  String?    @db.Text
  posterUrl    String?
  status       LiveStatus @default(SCHEDULED)
  scheduledFor DateTime?
  startedAt    DateTime?
  endedAt      DateTime?
  provider     String?
  providerRef  String?
  playbackUrl  String?
  accessType   AccessType @default(FREE)
  priceCents   Int?
  artistId     String?
  replayVideoId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  artist      Artist? @relation(fields: [artistId], references: [id], onDelete: SetNull)
  replayVideo Video?  @relation(fields: [replayVideoId], references: [id], onDelete: SetNull)
  homepageItems HomepageItem[]

  @@index([status, scheduledFor])
}

// ---------------------------------------------------------------------------
// SHOP
// ---------------------------------------------------------------------------

model ProductCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Collection {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[] @relation("CollectionProducts")
}

model Product {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  description    String?  @db.Text
  sku            String?  @unique
  categoryId     String?
  priceCents     Int
  salePriceCents Int?
  currency       String   @default("usd")
  inventory      Int      @default(0)
  trackInventory Boolean  @default(true)
  requiresShipping Boolean @default(true)
  isDigital      Boolean  @default(false)
  digitalAssetUrl String?
  weightGrams    Int?
  active         Boolean  @default(true)
  featured       Boolean  @default(false)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category    ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  collections Collection[]     @relation("CollectionProducts")
  images      ProductImage[]
  variants    ProductVariant[]
  artists     Artist[]         @relation("ProductArtists")
  articles    Article[]        @relation("ArticleProducts")
  cartItems   CartItem[]
  homepageItems HomepageItem[]

  @@index([active, featured])
  @@index([categoryId])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  altText   String?
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductVariant {
  id             String  @id @default(cuid())
  productId      String
  name           String
  sku            String? @unique
  size           String?
  color          String?
  style          String?
  priceCents     Int?
  inventory      Int     @default(0)
  position       Int     @default(0)
  active         Boolean @default(true)

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@index([productId])
}

// ---------------------------------------------------------------------------
// CART / ORDERS / COMMERCE
// ---------------------------------------------------------------------------

model Cart {
  id        String   @id @default(cuid())
  userId    String?
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items CartItem[]

  @@index([userId])
}

model CartItem {
  id             String          @id @default(cuid())
  cartId         String
  kind           PurchasableKind
  productId      String?
  variantId      String?
  refId          String?
  quantity       Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([cartId])
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  userId         String?
  email          String
  status         OrderStatus @default(PENDING)
  currency       String      @default("usd")
  subtotalCents  Int         @default(0)
  shippingCents  Int         @default(0)
  taxCents       Int         @default(0)
  discountCents  Int         @default(0)
  totalCents     Int         @default(0)
  refundedCents  Int         @default(0)
  paymentProvider String     @default("stripe")
  paymentRef     String?     @unique
  paymentIntentId String?
  shippingName   String?
  shippingLine1  String?
  shippingLine2  String?
  shippingCity   String?
  shippingState  String?
  shippingPostal String?
  shippingCountry String?
  requiresShipping Boolean   @default(false)
  fulfilledAt    DateTime?
  canceledAt     DateTime?
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  entitlements Entitlement[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id            String          @id @default(cuid())
  orderId       String
  kind          PurchasableKind
  refId         String?
  productId     String?
  variantId     String?
  titleSnapshot String
  variantSnapshot String?
  imageSnapshot String?
  skuSnapshot   String?
  unitPriceCents Int
  quantity      Int             @default(1)
  totalCents    Int
  requiresShipping Boolean      @default(false)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Entitlement {
  id        String            @id @default(cuid())
  userId    String
  kind      EntitlementKind
  refId     String
  source    EntitlementSource @default(PURCHASE)
  orderId   String?
  grantedAt DateTime          @default(now())
  expiresAt DateTime?
  revokedAt DateTime?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, kind, refId])
  @@index([userId, kind])
}

// ---------------------------------------------------------------------------
// PLANS / SUBSCRIPTIONS
// ---------------------------------------------------------------------------

model Plan {
  id              String   @id @default(cuid())
  kind            PlanKind
  key             PlanKey  @unique
  name            String
  tagline         String?
  description     String?  @db.Text
  priceCents      Int      @default(0)
  currency        String   @default("usd")
  interval        String   @default("month")
  stripePriceId   String?
  active          Boolean  @default(true)
  visible         Boolean  @default(true)
  position        Int      @default(0)
  // Entitlement configuration (admin-editable, never hardcoded in components)
  memberContentAccess Boolean @default(false)
  earlyAccess         Boolean @default(false)
  adFree              Boolean @default(false)
  shopDiscountPercent Int     @default(0)
  canUploadMusic      Boolean @default(false)
  canSellMerch        Boolean @default(false)
  canGoLive           Boolean @default(false)
  advancedAnalytics   Boolean @default(false)
  maxUploads          Int?
  perks               String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  planId               String
  status               SubscriptionStatus @default(INCOMPLETE)
  stripeSubscriptionId String?            @unique
  stripeCustomerId     String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  endedAt              DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId, status])
}

// ---------------------------------------------------------------------------
// CREATORS
// ---------------------------------------------------------------------------

model CreatorProfile {
  id          String        @id @default(cuid())
  userId      String        @unique
  tier        CreatorTier   @default(ARTIST)
  status      CreatorStatus @default(PENDING)
  displayName String
  contactEmail String?
  payoutNotes String?
  approvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist?

  @@index([status])
}

model CreatorAgreement {
  id            String   @id @default(cuid())
  version       String   @unique
  title         String
  body          String   @db.Text
  effectiveDate DateTime @default(now())
  active        Boolean  @default(false)
  createdAt     DateTime @default(now())

  acceptances CreatorAgreementAcceptance[]
}

model CreatorAgreementAcceptance {
  id          String   @id @default(cuid())
  agreementId String
  userId      String
  version     String
  acceptedAt  DateTime @default(now())
  ip          String?
  userAgent   String?

  agreement CreatorAgreement @relation(fields: [agreementId], references: [id])
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agreementId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// COMMUNITY
// ---------------------------------------------------------------------------

model Post {
  id           String   @id @default(cuid())
  authorId     String
  body         String   @db.Text
  imageUrl     String?
  likeCount    Int      @default(0)
  commentCount Int      @default(0)
  hidden       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  reactions Reaction[]

  @@index([createdAt])
  @@index([authorId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  body      String   @db.Text
  likeCount Int      @default(0)
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]  @relation("CommentReplies")
  reactions Reaction[]

  @@index([postId, createdAt])
}

model Reaction {
  id        String   @id @default(cuid())
  userId    String
  postId    String?
  commentId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model ArtistFollow {
  id        String   @id @default(cuid())
  userId    String
  artistId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([userId, artistId])
  @@index([artistId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Report {
  id         String           @id @default(cuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  reason     ReportReason
  details    String?
  status     ReportStatus     @default(OPEN)
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model ModerationAction {
  id          String   @id @default(cuid())
  moderatorId String
  action      String
  targetType  String
  targetId    String
  reason      String?
  createdAt   DateTime @default(now())

  moderator User @relation("Moderator", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// HEARTFELT
// ---------------------------------------------------------------------------

model Campaign {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  summary       String?
  story         String         @db.Text
  heroImageUrl  String?
  thumbnailUrl  String?
  category      String?
  location      String?
  goalCents     Int            @default(0)
  raisedCents   Int            @default(0)
  donationEnabled Boolean      @default(false)
  status        CampaignStatus @default(DRAFT)
  featured      Boolean        @default(false)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  updates   CampaignUpdate[]
  donations Donation[]
  homepageItems HomepageItem[]

  @@index([status, featured])
}

model CampaignUpdate {
  id         String   @id @default(cuid())
  campaignId String
  title      String
  body       String   @db.Text
  imageUrl   String?
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
}

model Donation {
  id         String   @id @default(cuid())
  campaignId String
  userId     String?
  email      String?
  amountCents Int
  currency   String   @default("usd")
  anonymous  Boolean  @default(false)
  message    String?
  paymentRef String?  @unique
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([campaignId])
}

// ---------------------------------------------------------------------------
// HOMEPAGE / SETTINGS / OPS
// ---------------------------------------------------------------------------

model HomepageSection {
  id        String              @id @default(cuid())
  key       String              @unique
  type      HomepageSectionType
  title     String
  subtitle  String?
  ctaLabel  String?
  ctaHref   String?
  position  Int                 @default(0)
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  items HomepageItem[]
}

model HomepageItem {
  id          String           @id @default(cuid())
  sectionId   String
  kind        HomepageItemKind
  position    Int              @default(0)
  headline    String?
  subheadline String?
  imageUrl    String?
  videoUrl    String?
  ctaLabel    String?
  ctaHref     String?
  secondaryCtaLabel String?
  secondaryCtaHref  String?
  eyebrow     String?
  articleId   String?
  videoId     String?
  songId      String?
  albumId     String?
  artistId    String?
  productId   String?
  campaignId  String?
  liveStreamId String?

  section  HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  article  Article?        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  video    Video?          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  song     Song?           @relation(fields: [songId], references: [id], onDelete: Cascade)
  album    Album?          @relation(fields: [albumId], references: [id], onDelete: Cascade)
  artist   Artist?         @relation(fields: [artistId], references: [id], onDelete: Cascade)
  product  Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  campaign Campaign?       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  liveStream LiveStream?   @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)

  @@index([sectionId, position])
}

model SiteSetting {
  key       String   @id
  value     Json
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  name       String
  userId     String?
  entityType String?
  entityId   String?
  path       String?
  referrer   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
}

model WebhookEvent {
  id          String   @id
  provider    String   @default("stripe")
  type        String
  processedAt DateTime @default(now())
  payloadHash String?

  @@index([provider, type])
}
