// Boosie Network — relational schema
// All money is stored as integer cents (never floats).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  USER
  ARTIST
  ARTIST_PRO
  EDITOR
  MODERATOR
  ADMIN
  OWNER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum AccessType {
  FREE
  MEMBERSHIP
  PURCHASE
}

enum VideoKind {
  MOVIE
  DOCUMENTARY
  SERIES
  EPISODE
  INTERVIEW
  MUSIC_VIDEO
  TRAILER
  BEHIND_THE_SCENES
  EXCLUSIVE
}

enum PlanKind {
  FAN
  CREATOR
}

enum PlanKey {
  FREE
  FAMILY
  INSIDER
  ARTIST
  ARTIST_PRO
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  FULFILLED
  CANCELED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PurchasableKind {
  PRODUCT
  SONG
  ALBUM
  VIDEO
  DIGITAL_PRODUCT
  MEMBERSHIP
  DONATION
}

enum EntitlementKind {
  SONG
  ALBUM
  VIDEO
  DIGITAL_PRODUCT
  MEMBERSHIP
}

enum EntitlementSource {
  PURCHASE
  SUBSCRIPTION
  GRANT
}

enum MediaKind {
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
}

enum LiveStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELED
}

enum CreatorTier {
  ARTIST
  ARTIST_PRO
}

enum CreatorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  VIOLENCE
  SEXUAL_CONTENT
  MISINFORMATION
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

enum ReportTargetType {
  POST
  COMMENT
  USER
}

enum NotificationType {
  FOLLOW
  COMMENT
  REPLY
  REACTION
  ORDER
  SUBSCRIPTION
  CONTENT
  SYSTEM
  MODERATION
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum HomepageSectionType {
  HERO
  CULTURE_RAIL
  WATCH_RAIL
  LISTEN_RAIL
  RADIO
  SHOP_RAIL
  ARTIST_SPOTLIGHT
  COMMUNITY
  HEARTFELT
  MEMBERSHIP
  BOOSIE_FEATURE
}

enum HomepageItemKind {
  ARTICLE
  VIDEO
  SONG
  ALBUM
  ARTIST
  PRODUCT
  CAMPAIGN
  LIVE_STREAM
  CUSTOM
}

// ---------------------------------------------------------------------------
// IDENTITY / AUTH
// ---------------------------------------------------------------------------

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  emailVerified  DateTime?
  passwordHash   String
  name           String
  username       String     @unique
  bio            String?
  avatarUrl      String?
  bannerUrl      String?
  location       String?
  role           Role       @default(USER)
  status         UserStatus @default(ACTIVE)
  isCreator      Boolean    @default(false)
  lastLoginAt    DateTime?
  failedLogins   Int        @default(0)
  lockedUntil    DateTime?
  stripeCustomerId String?  @unique
  marketingOptIn Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  sessions          Session[]
  resetTokens       PasswordResetToken[]
  carts             Cart[]
  orders            Order[]
  entitlements      Entitlement[]
  subscriptions     Subscription[]
  creatorProfile    CreatorProfile?
  articlesAuthored  Article[]           @relation("ArticleEditor")
  posts             Post[]
  comments          Comment[]
  reactions         Reaction[]
  following         Follow[]            @relation("Follower")
  followers         Follow[]            @relation("Following")
  artistFollows     ArtistFollow[]
  notifications     Notification[]
  reportsFiled      Report[]            @relation("Reporter")
  blocksMade        Block[]             @relation("Blocker")
  blocksReceived    Block[]             @relation("Blocked")
  auditLogs         AuditLog[]
  events            AnalyticsEvent[]
  mediaUploads      MediaAsset[]
  agreementAccepts  CreatorAgreementAcceptance[]
  moderationActions ModerationAction[]  @relation("Moderator")
  donations         Donation[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ---------------------------------------------------------------------------
// MEDIA
// ---------------------------------------------------------------------------

model MediaAsset {
  id           String    @id @default(cuid())
  kind         MediaKind
  storageKey   String    @unique
  url          String
  fileName     String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  durationSec  Int?
  altText      String?
  uploadedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([kind])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// CULTURE (editorial)
// ---------------------------------------------------------------------------

model Author {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  title       String?
  bio         String?
  avatarUrl   String?
  twitterUrl  String?
  instagramUrl String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  articles Article[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  articles Article[]
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  articles Article[] @relation("ArticleTags")
}

model Article {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  dek            String?
  excerpt        String?
  body           String        @db.Text
  heroImageUrl   String?
  thumbnailUrl   String?
  socialImageUrl String?
  seoTitle       String?
  seoDescription String?
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  featured       Boolean       @default(false)
  breaking       Boolean       @default(false)
  readMinutes    Int           @default(3)
  viewCount      Int           @default(0)
  authorId       String?
  categoryId     String?
  editorId       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  author   Author?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  editor   User?     @relation("ArticleEditor", fields: [editorId], references: [id], onDelete: SetNull)
  tags     Tag[]     @relation("ArticleTags")

  relatedSongs    Song[]    @relation("ArticleSongs")
  relatedProducts Product[] @relation("ArticleProducts")
  relatedArtists  Artist[]  @relation("ArticleArtists")

  homepageItems HomepageItem[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([featured])
  @@index([breaking])
}

// ---------------------------------------------------------------------------
// MUSIC (Listen)
// ---------------------------------------------------------------------------

model Genre {
  id     String  @id @default(cuid())
  name   String  @unique
  slug   String  @unique

  songs  Song[]  @relation("SongGenres")
  albums Album[] @relation("AlbumGenres")
  videos Video[] @relation("VideoGenres")
}

model Artist {
  id           String        @id @default(cuid())
  stageName    String
  slug         String        @unique
  bio          String?       @db.Text
  location     String?
  profileImageUrl String?
  heroImageUrl
